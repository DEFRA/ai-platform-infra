{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "provider",
    "offering",
    "family",
    "modelName",
    "version",
    "skus",
    "displayName",
    "tiers",
    "environments",
    "dataZone",
    "regions",
    "apiProfile",
    "capacityPolicy",
    "lifecycle",
    "eligibility"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "slug": { "$ref": "#/$defs/id" },
    "provider": { "$ref": "#/$defs/id" },
    "offering": { "$ref": "#/$defs/id" },
    "family": { "type": "string", "minLength": 1 },
    "modelName": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "deploymentName": {
      "description": "Name of the Research deployment, which is the public contract of the research API: the caller sends it as the spec defines and nothing translates it. Team deployments are named by the naming module.",
      "type": "string",
      "minLength": 1
    },
    "skus": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sku" }
    },
    "displayName": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "useCases": { "type": "array", "items": { "type": "string" } },
    "tiers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["research", "team"] }
    },
    "environments": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]{1,15}$" }
    },
    "dataZone": { "$ref": "#/$defs/dataZone" },
    "regions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/region" }
    },
    "apiProfile": {
      "enum": ["chat-completions", "responses", "messages", "embeddings"]
    },
    "capacityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "default"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "default": { "type": "integer", "minimum": 1 },
        "environments": {
          "description": "Per-environment overrides; quota is the environment total, in thousands of tokens per minute, that the sum check uses across every team.",
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9]{1,15}$" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["quota"],
            "properties": {
              "min": { "type": "integer", "minimum": 1 },
              "max": { "type": "integer", "minimum": 1 },
              "default": { "type": "integer", "minimum": 1 },
              "quota": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "limitsDefault": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestsPerMinute": { "type": "integer", "minimum": 1 },
        "tokensPerDay": { "type": "integer", "minimum": 1 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "retirementDate"],
      "properties": {
        "status": {
          "enum": ["proposed", "eligible", "available", "deprecated", "retired"]
        },
        "retirementDate": {
          "oneOf": [{ "type": "null" }, { "type": "string", "format": "date" }]
        }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligible", "reason"],
      "properties": {
        "eligible": { "type": "boolean" },
        "reason": { "type": ["string", "null"] }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "href"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "href": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "region": { "enum": ["uksouth", "swedencentral"] },
    "dataZone": { "enum": ["uk", "eu"] },
    "sku": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "enum": [
            "Standard",
            "DataZoneStandard",
            "GlobalStandard",
            "ProvisionedManaged",
            "DataZoneProvisionedManaged",
            "GlobalProvisionedManaged",
            "DataZoneBatch",
            "GlobalBatch"
          ]
        },
        "capacity": {
          "description": "Capacity of the hand-built Research deployment.",
          "type": "integer",
          "minimum": 1
        },
        "tiers": {
          "description": "Tiers that may use this SKU; a SKU without tiers is the hand-built Research deployment.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["research", "team"] }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/region" }
        },
        "dataZone": { "$ref": "#/$defs/dataZone" }
      }
    }
  }
}
