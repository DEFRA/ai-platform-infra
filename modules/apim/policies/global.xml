<policies>
  <inbound>
    <!--
      Global layer (design E #enforcement; gateway authorisation layers plan G1 to G6 and the
      gate): every API on the gateway is authenticated here, generically, before any team
      policy runs, and this layer holds no team data. A lower policy can only narrow access.
      G1: the tier comes from the API's own path against the platform's key-tier list, and
      nothing a lower policy sets changes it; every path not on the list is OAuth, so an API
      with no policy of its own still needs a valid token. The key guard (G2) or
      aip-authorise (G3 to G6) follows. The shared request steps refuse to route a call
      without aipAuthenticated, so a team policy that lost its <base /> routes nothing.
    -->
    <set-variable name="aipTier" value="@("${key_tier_paths}".Split(',').Contains(context.Api.Path) ? "key" : "oauth")" />
    <choose>
      <when condition="@((string)context.Variables["aipTier"] == "key")">
        <include-fragment fragment-id="${key_guard_fragment}" />
      </when>
      <otherwise>
        <include-fragment fragment-id="${authorise_fragment}" />
      </otherwise>
    </choose>
    <set-variable name="aipAuthenticated" value="true" />
  </inbound>
  <backend>
    <!--
      The gate: only a request a lower layer marked granted (aipGrantedCall, set where the
      team's client, window and model checks pass) is forwarded, so an API with no team
      policy authenticates and still reaches no model.
    -->
    <choose>
      <when condition="@(!context.Variables.ContainsKey("aipGrantedCall"))">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"code":"client-not-granted"}</set-body>
        </return-response>
      </when>
    </choose>
    <forward-request timeout="300" buffer-response="false" />
  </backend>
  <outbound>
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="X-AspNet-Version" exists-action="delete" />
  </outbound>
  <on-error>
    <!--
      A validate-jwt failure jumps here, so its 401 can carry WWW-Authenticate (RFC 6750
      section 3): the bare challenge for a missing token, invalid_token for any other failure.
    -->
    <choose>
      <when condition="@("validate-jwt".Equals(context.LastError?.Source))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-header name="WWW-Authenticate" exists-action="override">
            <value>@(context.LastError.Reason == "TokenNotPresent" ? "Bearer" : "Bearer error=\"invalid_token\"")</value>
          </set-header>
          <set-body>{"code":"invalid-token"}</set-body>
        </return-response>
      </when>
    </choose>
  </on-error>
</policies>
