<policies>
  <inbound>
    <set-variable name="aipTeam" value="${team}" />
    <set-variable name="aipCredentialType" value="oauth" />
    <set-variable name="aipClients" value="{{${clients_named_value}}}" />
    <set-variable name="aipAccess" value="{{${access_named_value}}}" />
    <set-variable name="aipGranted" value="${granted}" />
    <base />
    <include-fragment fragment-id="${fragments.whoami}" />
    <include-fragment fragment-id="${fragments.request_model}" />
%{ if length(models) > 0 ~}
    <choose>
%{ for model in models ~}
      <when condition="@((string)context.Variables["aipRequested"] == "${model.slug}")">
        <set-variable name="aipDeployment" value="${model.deployment_name}" />
        <set-variable name="aipHosting" value="${model.hosting}" />
        <set-backend-service backend-id="${model.backend_id}" />
      </when>
%{ endfor ~}
      <otherwise>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"code":"model-not-granted"}</set-body>
        </return-response>
      </otherwise>
    </choose>
%{ else ~}
    <return-response>
      <set-status code="403" reason="Forbidden" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-body>{"code":"model-not-granted"}</set-body>
    </return-response>
%{ endif ~}
    <rate-limit-by-key calls="${requests_per_minute}" renewal-period="60" counter-key="@(context.Api.Id)" />
    <llm-token-limit counter-key="@(context.Api.Id)" tokens-per-minute="${tokens_per_minute}" estimate-prompt-tokens="false" remaining-tokens-header-name="x-ratelimit-remaining-tokens" />
    <llm-emit-token-metric namespace="aip">
      <dimension name="team" value="${team}" />
      <dimension name="deployment" value="@((string)context.Variables["aipDeployment"])" />
      <dimension name="credentialType" value="oauth" />
    </llm-emit-token-metric>
%{ for hosting in hostings ~}
    <choose>
      <when condition="@((string)context.Variables["aipHosting"] == "${hosting}")">
        <include-fragment fragment-id="${fragments.backend[hosting]}" />
      </when>
    </choose>
%{ endfor ~}
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
