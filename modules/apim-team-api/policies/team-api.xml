<policies>
  <inbound>
    <set-variable name="aipTeam" value="${team}" />
    <set-variable name="aipCredentialType" value="${credential_type}" />%{ if credential_type == "oauth" }
    <set-variable name="aipClients" value="{{${clients_named_value}}}" />
    <set-variable name="aipAccess" value="{{${access_named_value}}}" />%{ endif }
    <set-variable name="aipGranted" value="${granted}" />
    <base />
    <include-fragment fragment-id="${fragments.whoami}" />%{ if credential_type == "oauth" }
    <include-fragment fragment-id="${fragments.request_model}" />%{ else }
    <!-- Research: nothing translates the name; the caller's deployment name is checked against the allow-list and forwarded as sent. -->
    <set-variable name="aipRequested" value="@{
      var fromPath = context.Request.MatchedParameters.GetValueOrDefault("deployment-id", "");
      if (!string.IsNullOrEmpty(fromPath)) { return fromPath; }
      if (context.Request.Body == null) { return ""; }
      var body = context.Request.Body.As<JObject>(preserveContent: true);
      return body["model"] == null ? "" : body["model"].ToString();
    }" />
    <set-query-parameter name="subscription-key" exists-action="delete" />%{ endif }
%{ if length(routes) > 0 ~}
    <choose>
%{ for route in routes ~}
      <when condition="@((string)context.Variables["aipRequested"] == "${route.match}")">
        <set-variable name="aipDeployment" value="${route.forward}" />
        <set-variable name="aipHosting" value="${route.hosting}" />
        <set-backend-service backend-id="${route.backend_id}" />
      </when>
%{ endfor ~}
      <otherwise>
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/json</value>
          </set-header>
          <set-body>{"code":"model-not-granted"}</set-body>
        </return-response>
      </otherwise>
    </choose>
%{ else ~}
    <return-response>
      <set-status code="403" reason="Forbidden" />
      <set-header name="Content-Type" exists-action="override">
        <value>application/json</value>
      </set-header>
      <set-body>{"code":"model-not-granted"}</set-body>
    </return-response>
%{ endif ~}
    <rate-limit-by-key calls="${requests_per_minute}" renewal-period="60" counter-key="@(${counter_key})" />
    <llm-token-limit counter-key="@(${counter_key})" tokens-per-minute="${tokens_per_minute}" estimate-prompt-tokens="false" remaining-tokens-header-name="x-ratelimit-remaining-tokens" />
    <llm-emit-token-metric namespace="aip">
      <dimension name="team" value="${team}" />
      <dimension name="deployment" value="@((string)context.Variables["aipDeployment"])" />
      <dimension name="credentialType" value="${credential_type}" />
    </llm-emit-token-metric>
%{ for hosting in hostings ~}
    <choose>
      <when condition="@((string)context.Variables["aipHosting"] == "${hosting}")">
        <include-fragment fragment-id="${fragments.backend[hosting]}" />
      </when>
    </choose>
%{ endfor ~}
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
